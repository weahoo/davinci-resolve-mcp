# Node (resolve-advanced — the davinci-resolve-advanced-mcp server + vendored libs)
# No trailing slash: a trailing slash matches directories only, so a SYMLINK
# named node_modules (handy for pointing a git worktree at the primary tree's
# installed deps) slipped past these and got committed once. Match both.
node_modules
node_modules/
resolve-advanced/node_modules
resolve-advanced/node_modules/

# Python (envs, build artifacts, caches)
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
venv/
env/
.venv
.env
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
*.egg-info/
.installed.cfg
*.egg

# Logs and temporary files
*.log
*.log.bak
*.swp
.DS_Store
to_clean/
logs_backup/
cleanup_backup/
tmp/
tests/*_results.json
results.tsv
# Keep the logs directory but not its contents
logs/*
!logs/.gitkeep

# Configuration files with sensitive info
# Don't ignore templates
.mcp.json
.mcp.json.backup
claude_desktop_config.json
!config-templates/*.template.json

# IDE / editor
.idea/
.vscode/
.cursor/*
# ...but track the generated cross-platform agent rules (see scripts/agent-rules/)
!.cursor/rules/
*.sublime-project
*.sublime-workspace
.specstory/
.cursorindexingignore

# Session-specific files
*.session
*.pid

# PyInstaller
*.manifest
*.spec

# Installer logs
pip-log.txt
pip-delete-this-directory.txt

# Unit test / coverage reports
htmlcov/
.tox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
.hypothesis/
.pytest_cache/

# macOS specific files
.AppleDouble
.LSOverride

# Any backup directories
*_backup/

# Autoresearch framework (local development only)
autoresearch/

# Local planning notes / scratch artifacts — anywhere in the tree.
# Policy: gameplans and in-flight design docs are never committed; they live in local/.
docs/_scratch/
docs/_design/
**/*gameplan*.md
docs/superpowers/specs/
**/*ledger*.json
**/*review-log*.md
**/*session*.md

# Resolve MCP media analysis artifacts
.davinci-resolve-mcp-analysis/
davinci-resolve-mcp-analysis/

# Export artifacts at the repo root. Backstop only: tests must not write into
# the working directory at all (see tests/_paths.py), but a guard-rejection
# test that stops rejecting writes a real file, and one such look.cube reached
# a PR before anyone noticed. Root-anchored so genuine fixtures under tests/
# and docs/ are unaffected.
/*.cube
/*.dctl
/*.drx
/*.mov
/*.mp4
/*.wav

# Local scratch / personal tooling attached to this project.
# Holds design docs, calibration references, release-notes drafts, the screenshot
# capture script, and one-off repro scripts. Never shipped. See local/README.md.
/local/
.claude/launch.json

